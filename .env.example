# Paper Radar - Environment Configuration

# Contact Email for User-Agent Header (Required for ethical scraping compliance)
RADAR_CONTACT_EMAIL=researcher@example.com

# Run Profile: LOCAL_LITE, LOCAL_PLUS, or CLOUD
RADAR_PROFILE=LOCAL_LITE

# Optional Semantic Scholar API Key (raises rate limits if available)
SEMANTIC_SCHOLAR_API_KEY=

# Optional Telegram Bot for Daily Digest notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Hosted LLM for Summarization (e.g. OpenAI or Groq)
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Local Ollama URL (used when profile is LOCAL_PLUS or summary mode is ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
